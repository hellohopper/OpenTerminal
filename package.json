{
  "name": "openterminal",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "overrides": {
    "qs": "^6.16.0",
    "postcss": "^8.5.30",
    "express": {
      "qs": "^6.16.0"
    }
  },
  "scripts": {
    "mac:menu": "node scripts/mac-service.mjs menu",
    "mac:start": "node scripts/mac-service.mjs start",
    "mac:stop": "node scripts/mac-service.mjs stop",
    "mac:restart": "node scripts/mac-service.mjs restart",
    "mac:status": "node scripts/mac-service.mjs status",
    "mac:doctor": "node scripts/mac-service.mjs doctor",
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "start": "concurrently -n api,web \"npm run start -w server\" \"npm run start -w web\"",
    "test": "npm run test -w server",
    "lint": "npm run lint -w web",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
